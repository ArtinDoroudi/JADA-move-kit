# Synthetic local settings for the isolated JADA NPRI v0 environment.
# These values are not production credentials. No real LLM key is used by tests.
DATABASE_URL=postgresql://npri_v0:npri_v0_local_only@localhost:55432/npri_v0_dev
REDIS_URL=redis://localhost:56379/0

# Local-only signing key; replace before any service is exposed beyond localhost.
SECRET_KEY=jada-npri-v0-local-development-key-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEFAULT_ADMIN_EMAIL=admin-v0@example.invalid
DEFAULT_ADMIN_PASSWORD=LocalOnly-V0-Password-NotForProduction
DEFAULT_ADMIN_FULL_NAME=Local NPRI v0 Admin

# Deliberately unusable placeholder. Baseline tests must mock external LLM calls.
ANTHROPIC_API_KEY=sk-ant-local-placeholder-not-a-real-key

TEST_DATABASE_URL=postgresql://npri_v0:npri_v0_local_only@localhost:55432/npri_v0_test
STORAGE_DIR=./storage-v0

LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=4096
LLM_PURCHASE_MAX_TOKENS=32000
LLM_MATCHING_MAX_TOKENS=32000
LLM_RATE_LIMIT_MAX_RETRIES=96
LLM_RATE_LIMIT_RETRY_BASE_SECONDS=60
LLM_RATE_LIMIT_RETRY_MAX_SECONDS=900
